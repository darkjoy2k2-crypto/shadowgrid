<Window x:Class="ShadowgridLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shadowgrid Launcher" Height="400" Width="400" Background="#1e1e1e">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="SHADOWGRID CONFIGURATION" Foreground="#00ffcc" FontSize="18" FontWeight="Bold" Grid.Row="0" Margin="0,0,0,20" HorizontalAlignment="Center"/>

        <TextBlock Text="Resolution:" Foreground="White" Grid.Row="1"/>
        <ComboBox x:Name="ComboResolution" Grid.Row="2" Margin="0,5,0,15" Background="#333" Foreground="Black">
            <ComboBoxItem Content="1280x720" IsSelected="True"/>
            <ComboBoxItem Content="1920x1080"/>
            <ComboBoxItem Content="2560x1440"/>
        </ComboBox>

        <TextBlock Text="Monitor:" Foreground="White" Grid.Row="3"/>
        <ComboBox x:Name="ComboMonitor" Grid.Row="4" Margin="0,5,0,15" Background="#333" Foreground="Black">
            <ComboBoxItem Content="Display 1" IsSelected="True"/>
            <ComboBoxItem Content="Display 2"/>
        </ComboBox>

        <TextBlock Text="Audio Device:" Foreground="White" Grid.Row="5"/>
        <ComboBox x:Name="ComboAudio" Grid.Row="6" Margin="0,5,0,15" Background="#333" Foreground="Black">
            <ComboBoxItem Content="Default System Audio" IsSelected="True"/>
        </ComboBox>

        <CheckBox x:Name="ChkFullscreen" Content="Fullscreen" Foreground="White" Grid.Row="7" Margin="0,0,0,15"/>

        <Button x:Name="BtnStart" Content="START GAME" Grid.Row="8" Height="40" Background="#009664" Foreground="White" FontWeight="Bold" Click="BtnStart_Click"/>
    </Grid>
</Window>
