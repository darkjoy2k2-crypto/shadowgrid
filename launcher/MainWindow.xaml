<Window x:Class="ShadowgridLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shadowgrid Launcher" Icon="app_icon.ico"
        Width="640" Height="360"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0a0a0a">
    <Grid>
        <!-- Background Image (jack_dead) -->
        <Image Source="dead.png" Stretch="Fill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

        <!-- Right Side Overlay Panel -->
        <Border HorizontalAlignment="Right" Width="310" Margin="0,8,10,8"
                Background="#D9101418" CornerRadius="8" Padding="14,10,14,10"
                BorderBrush="#00FFCC" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Label SHADOWGRID Top Right -->
                    <TextBlock Text="SHADOWGRID" Foreground="#00FFCC" FontSize="22" FontWeight="Bold" 
                               HorizontalAlignment="Right" Margin="0,0,0,8">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#00FFCC" BlurRadius="8" ShadowDepth="0"/>
                        </TextBlock.Effect>
                    </TextBlock>

                    <!-- Game Module -->
                    <TextBlock Text="Game Module:" Foreground="#00FFCC" FontSize="11" FontWeight="Bold" Margin="0,2,0,2"/>
                    <ComboBox x:Name="ComboGame" Height="24" FontSize="11" Margin="0,0,0,6" Background="#222" Foreground="Black">
                        <ComboBoxItem Content="Shadowgrid (Cyberdeck Infiltration)" IsSelected="True"/>
                        <ComboBoxItem Content="Deck-Battle Minigame (Disposition)"/>
                    </ComboBox>

                    <!-- Resolution & Display in 2 Columns -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                            <TextBlock Text="Resolution:" Foreground="White" FontSize="11" Margin="0,0,0,2"/>
                            <ComboBox x:Name="ComboResolution" Height="24" FontSize="11" Background="#222" Foreground="Black">
                                <ComboBoxItem Content="1280x720" IsSelected="True"/>
                                <ComboBoxItem Content="1920x1080"/>
                                <ComboBoxItem Content="2560x1440"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                            <TextBlock Text="Monitor:" Foreground="White" FontSize="11" Margin="0,0,0,2"/>
                            <ComboBox x:Name="ComboMonitor" Height="24" FontSize="11" Background="#222" Foreground="Black">
                                <ComboBoxItem Content="Display 1" IsSelected="True"/>
                                <ComboBoxItem Content="Display 2"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- Audio Device -->
                    <TextBlock Text="Audio Device:" Foreground="White" FontSize="11" Margin="0,0,0,2"/>
                    <ComboBox x:Name="ComboAudio" Height="24" FontSize="11" Margin="0,0,0,6" Background="#222" Foreground="Black">
                        <ComboBoxItem Content="Default System Audio" IsSelected="True"/>
                    </ComboBox>

                    <!-- Fullscreen Checkbox -->
                    <CheckBox x:Name="ChkFullscreen" Content="Fullscreen" Foreground="White" FontSize="11" Margin="0,2,0,8"/>

                    <!-- Start Button -->
                    <Button x:Name="BtnStart" Content="START GAME" Height="32" Background="#009664" Foreground="White" 
                            FontWeight="Bold" FontSize="13" Click="BtnStart_Click" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
